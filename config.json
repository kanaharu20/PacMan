# Pac-Man の設定ファイル
# 「#」で始まる行はコメントとして無視されます。
# 値がない・おかしいときは既定値（範囲外なら範囲内の一番近い値）を使い、
# ターミナルにメッセージを出してそのまま起動します。知らないキーは無視します。
# 値はすべて整数です。
{
    # 残機（1〜9）
    "lives": 3,

    # レベル 1 の迷路のシード（0〜2147483647）。レベル 2 からは毎回ランダム
    #   0 にするとレベル 1 もランダムになります
    "seed": 42,

    # 得点（0〜1000000）
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,

    # レベルの制限時間（秒、10〜999）。0 になったら即ゲームオーバー
    #   levels の中で "level_max_time" を書いたレベルは、そちらを使います
    "level_max_time": 90,

    # レベルの一覧（上から順に遊ぶ）。各レベルの迷路の横と縦のマス数
    #   width: 14〜40、height: 10〜25
    #   10 個より少ないときは 21x21 のレベルを足して 10 個にします（最大 50 個）
    #   width / height を省略したレベルは、一番外に書いた "width" / "height"
    #   （どちらも書かなければ 21）を使います
    "levels": [
        {"width": 15, "height": 11},
        {"width": 15, "height": 13},
        {"width": 17, "height": 13},
        {"width": 17, "height": 15},
        {"width": 19, "height": 15},
        {"width": 19, "height": 17},
        {"width": 21, "height": 17, "level_max_time": 100},
        {"width": 21, "height": 19, "level_max_time": 110},
        {"width": 23, "height": 19, "level_max_time": 120},
        {"width": 23, "height": 21, "level_max_time": 130}
    ]
}
